@page
@model Ans.Net10.Web.Areas.Ans.Pages.System.ConsoleModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = null;
    var lastId1 = Model.Entries.Length > 0 ? Model.Entries[^1].Id : 0;
    var xsrfToken1 = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>System Console — Ans.Net10</title>
    <style>
        body { margin: 0; background: #0d1117; color: #c9d1d9; font-family: Consolas, 'Courier New', monospace; font-size: 13px; display: flex; flex-direction: column; height: 100vh; }
        header { background: #161b22; border-bottom: 1px solid #30363d; padding: 10px 16px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
        header h1 { margin: 0; font-size: 14px; color: #58a6ff; margin-right: auto; }
        select, button, label { background: #21262d; color: #c9d1d9; border: 1px solid #30363d; border-radius: 4px; padding: 4px 10px; font-family: inherit; font-size: 12px; cursor: pointer; }
        button:hover { background: #30363d; }
        label { display: flex; align-items: center; gap: 6px; border: none; background: transparent; padding: 0; }
        #terminal { flex: 1; overflow-y: auto; padding: 12px 16px; line-height: 1.45; }
        .row { white-space: pre-wrap; word-break: break-word; border-bottom: 1px solid #161b22; padding: 2px 0; }
        .ts { color: #8b949e; }
        .lvl { font-weight: bold; padding: 0 4px; border-radius: 3px; }
        .VRB, .DBG { color: #8b949e; }
        .INF { color: #3fb950; }
        .WRN { color: #d29922; }
        .ERR { color: #f85149; }
        .FTL { background: #da3633; color: #ffffff; }
        .ctx { color: #79c0ff; }
        .exc { color: #ffa198; display: block; margin-top: 2px; padding-left: 16px; border-left: 2px solid #f85149; }
    </style>
</head>
<body>
    <header>
        <h1>ANS SYSTEM CONSOLE (Buffer: @Model.Capacity)</h1>
        <select id="levelFilter">
            <option value="">All Levels</option>
            <option value="1">DBG+</option>
            <option value="2">INF+</option>
            <option value="3">WRN+</option>
            <option value="4">ERR+</option>
            <option value="5">FTL</option>
        </select>
        <label><input type="checkbox" id="liveCheck" checked /> Live (2s)</label>
        <label><input type="checkbox" id="scrollCheck" checked /> Auto-scroll</label>
        <button type="button" id="clearBtn">Clear</button>
    </header>

    <div id="terminal">
        @if (!Model.IsEnabled)
        {
            <div class="row WRN">In-memory log buffer is disabled (Serilog.MemoryBufferCapacity &lt;= 0).</div>
        }
        else
        {
            foreach (var item1 in Model.Entries)
            {
                <div class="row" data-lvl="@((int)item1.Level)">
                    <span class="ts">@item1.Timestamp.ToString("HH:mm:ss.fff")</span>
                    <span class="lvl @item1.LevelShortName">[@item1.LevelShortName]</span>
                    @if (!string.IsNullOrEmpty(item1.SourceContext))
                    {
                        <span class="ctx">[@item1.SourceContext]</span>
                    }
                    <span>@item1.Message</span>
                    @if (!string.IsNullOrEmpty(item1.Exception))
                    {
                        <span class="exc">@item1.Exception</span>
                    }
                </div>
            }
        }
    </div>

    <script>
        let lastId = @lastId1;
        const terminal = document.getElementById('terminal');
        const levelFilter = document.getElementById('levelFilter');
        const liveCheck = document.getElementById('liveCheck');
        const scrollCheck = document.getElementById('scrollCheck');
        const tokenParam = new URLSearchParams(window.location.search).get('token');
        const lvlNames = ['VRB', 'DBG', 'INF', 'WRN', 'ERR', 'FTL'];

        function buildUrl(handler, extra = '') {
            const q = new URLSearchParams(extra);
            q.set('handler', handler);
            if (tokenParam) q.set('token', tokenParam);
            return `${window.location.pathname}?${q.toString()}`;
        }

        function applyFilter() {
            const min = levelFilter.value ? parseInt(levelFilter.value, 10) : 0;
            for (const row of terminal.children) {
                const lvl = parseInt(row.dataset.lvl || '0', 10);
                row.style.display = lvl >= min ? '' : 'none';
            }
        }

        levelFilter.addEventListener('change', applyFilter);

        async function pollUpdates() {
            if (!liveCheck.checked) return;
            try {
                const res = await fetch(buildUrl('Updates', { afterId: lastId }));
                if (!res.ok) return;
                const items = await res.json();
                if (!items.length) return;

                const min = levelFilter.value ? parseInt(levelFilter.value, 10) : 0;
                for (const item of items) {
                    lastId = Math.max(lastId, item.id);
                    const code = lvlNames[item.level] || 'UNK';
                    const div = document.createElement('div');
                    div.className = 'row';
                    div.dataset.lvl = item.level;
                    if (item.level < min) div.style.display = 'none';

                    const d = new Date(item.timestamp);
                    const ts = d.toTimeString().split(' ')[0] + '.' + String(d.getMilliseconds()).padStart(3, '0');
                    div.innerHTML = `<span class="ts">${ts}</span> <span class="lvl ${code}">[${code}]</span> `
                        + (item.sourceContext ? `<span class="ctx">[${esc(item.sourceContext)}]</span> ` : '')
                        + `<span>${esc(item.message)}</span>`
                        + (item.exception ? `<span class="exc">${esc(item.exception)}</span>` : '');
                    terminal.appendChild(div);
                }
                if (scrollCheck.checked) terminal.scrollTop = terminal.scrollHeight;
            } catch { }
        }

        function esc(s) {
            return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

        document.getElementById('clearBtn').addEventListener('click', async () => {
            await fetch(buildUrl('Clear'), {
                method: 'POST',
                headers: { 'RequestVerificationToken': '@xsrfToken1' }
            });
            terminal.innerHTML = '';
        });

        terminal.scrollTop = terminal.scrollHeight;
        setInterval(pollUpdates, 2000);
    </script>
</body>
</html>
