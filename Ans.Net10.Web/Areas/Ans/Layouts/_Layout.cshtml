@{
    //Current.Site.Title = "Site 1";
}
<!DOCTYPE html>
<html lang="@Current.Culture" class="h-100">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @Current.Meta.Render()

    <title>@Current.BrowserTitleHtml</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <style>
        code {
            padding: .3rem .6rem;
            background-color: antiquewhite;
        }
    </style>

</head>
<body class="d-flex flex-column h-100">


    @* SITE HEADER *@
    @if (Current.IsKeyNotOff("Site.Header") && !await this.TrySectionAsync("CustomSiteHeaderSection"))
    {
        <header class="py-3 bg-light border-bottom">
            <site-container>
                @Current.Site.TitleHtml
            </site-container>
        </header>
    }


    @* NODE HEADER *@
    @if (Current.IsKeyNotOff("Node.Header") && !await this.TrySectionAsync("CustomNodeHeaderSection") && Current.Node.Title != null)
    {
        <header class="py-3 bg-light border-bottom">
            <node-container>
                @Current.Node.TitleHtml
            </node-container>
        </header>
    }


    @* NODE NAVIGATOR *@
    @if (Current.IsKeyNotOff("Node.Navigator") && Current.GetPagesNav(1).Count > 0 && !await this.TrySectionAsync("CustomNodeNavigatorSection"))
    {
        <header class="py-3 bg-light border-bottom">
            <node-container>
                <partial name="/Areas/Ans/Helpers/PagesTree.cshtml" />
            </node-container>
        </header>
    }
    

    @* PAGE MAIN *@
    <main role="main">
        @if (Current.IsKeyNotOff("Page.Header"))
        {
            <page-container>
                @if (Current.IsKeyNotOff("Breadcrumbs"))
                {
                    <partial name="/Areas/Ans/Helpers/Breadcrumbs.cshtml" />
                }
                @if (Current.IsKeyNotOff("Page.Title") && !string.IsNullOrEmpty(Current.Page.Title))
                {
                    <partial name="/Areas/Ans/Helpers/PageTitle.cshtml" />
                }
                @if (Current.IsKeyOn("Page.SubPages"))
                {
                    <partial name="/Areas/Ans/Helpers/SubPages.cshtml" />
                }
            </page-container>
        }
        @await RenderSectionAsync("PageBefore", false)
        <page-container class="content mb-5">
            @RenderBody()
        </page-container>
        @await RenderSectionAsync("PageAfter", false)
    </main>


    <div class="mt-auto">


        @* NODE FOOTER *@
        @if (Current.IsKeyOn("Node.Footer") && !await this.TrySectionAsync("CustomNodeFooterSection") && Current.Node.Title != null)
        {
            <footer class="py-3 bg-light border-top">
                <node-container>
                    @Current.Node.TitleHtml
                </node-container>
            </footer>
        }


        @* SITE FOOTER *@
        @if (Current.IsKeyNotOff("Site.Footer") && !await this.TrySectionAsync("CustomSiteFooterSection"))
        {
            <footer class="py-3 bg-light border-top">
                <site-container>
                    @Current.Site.TitleHtml
                </site-container>
            </footer>
        }


    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

</body>
</html>
