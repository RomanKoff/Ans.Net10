@*
    rev 2026-11-27
    
    Компонент библиотеки Ans.Net10.Web.
    Код не предназначен для редактирования и компиляции во время выполнения!
    
    ====================
    Информация о системе
    ====================

*@
@model object?
@using System.Diagnostics
@using System.Reflection
@using System.Runtime.InteropServices
@using Ans.Net10.Web.Services
@using Microsoft.AspNetCore.Hosting
@inject AnsSystemAccessService AccessService
@inject IWebHostEnvironment WebHostEnvironment

@{
    Current.Meta.RobotsOff();

    var hasAccess1 = await AccessService.HasAccessAsync();
    if (!hasAccess1 && !AccessService.HasAccessList)
    {
        Current.ThrowNotFound();
        return;
    }
}

<partial name="/Areas/Ans/Helpers/System/_AccessGate.cshtml" model="hasAccess1" />

@if (!hasAccess1)
{
    return;
}

@{
    var info1 = new SystemDiagnosticInfo(WebHostEnvironment);
}

<div class="d-flex flex-column gap-4">

    @* Сводка среды выполнения *@
    <div class="card shadow-sm">
        <div class="card-header fw-semibold">@Ans.Net10.Web.Resources.SystemHelpers.Info_RuntimeSectionTitle</div>
        <div class="card-body p-0">
            <table class="table table-sm table-hover mb-0 font-monospace" style="font-size: 0.82rem;">
                <tbody>
                    <tr>
                        <th class="ps-3 w-25 text-body-secondary">@Ans.Net10.Web.Resources.SystemHelpers.Info_Application</th>
                        <td>@WebHostEnvironment.ApplicationName</td>
                    </tr>
                    <tr>
                        <th class="ps-3 text-body-secondary">@Ans.Net10.Web.Resources.SystemHelpers.Info_Environment</th>
                        <td><span class="badge text-bg-primary">@WebHostEnvironment.EnvironmentName</span></td>
                    </tr>
                    <tr>
                        <th class="ps-3 text-body-secondary">.NET Runtime</th>
                        <td>@RuntimeInformation.FrameworkDescription (@RuntimeInformation.ProcessArchitecture)</td>
                    </tr>
                    <tr>
                        <th class="ps-3 text-body-secondary">@Ans.Net10.Web.Resources.SystemHelpers.Info_OsHost</th>
                        <td>@RuntimeInformation.OSDescription — @Environment.MachineName</td>
                    </tr>
                    <tr>
                        <th class="ps-3 text-body-secondary">ContentRootPath</th>
                        <td>@WebHostEnvironment.ContentRootPath</td>
                    </tr>
                    <tr>
                        <th class="ps-3 text-body-secondary">WebRootPath</th>
                        <td>@WebHostEnvironment.WebRootPath</td>
                    </tr>
                    <tr>
                        <th class="ps-3 text-body-secondary">@Ans.Net10.Web.Resources.SystemHelpers.Info_ProcessUptime</th>
                        <td>@string.Format(Ans.Net10.Web.Resources.SystemHelpers.Info_ProcessStatsFormat, Environment.ProcessId, info1.ProcessStartTime.ToString("yyyy-MM-dd HH:mm:ss"), info1.WorkingSetMb)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    @* Переменные окружения *@
    <div class="card shadow-sm">
        <div class="card-header fw-semibold">@Ans.Net10.Web.Resources.SystemHelpers.Info_EnvVarsSectionTitle</div>
        <div class="card-body p-0 overflow-x-auto">
            <table class="table table-sm table-hover mb-0 font-monospace" style="font-size: 0.78rem;">
                <tbody>
                    @foreach (var env1 in info1.EnvVars)
                    {
                        <tr>
                            <th class="ps-3 w-25 text-body-secondary">@env1.Key</th>
                            <td class="text-break">@env1.Value</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* Загруженные сборки *@
    <div class="card shadow-sm">
        <div class="card-header d-flex align-items-center">
            <span class="fw-semibold me-auto">@Ans.Net10.Web.Resources.SystemHelpers.Info_AssembliesSectionTitle</span>
            <span class="badge text-bg-secondary">@string.Format(Ans.Net10.Web.Resources.SystemHelpers.Info_TotalFormat, info1.Assemblies.Count)</span>
        </div>
        <div class="card-body p-0 overflow-x-auto">
            <table class="table table-sm table-hover mb-0 font-monospace" style="font-size: 0.78rem;">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">@Ans.Net10.Web.Resources.SystemHelpers.Col_Assembly</th>
                        <th>@Ans.Net10.Web.Resources.SystemHelpers.Col_Version</th>
                        <th>@Ans.Net10.Web.Resources.SystemHelpers.Col_Configuration</th>
                        <th>@Ans.Net10.Web.Resources.SystemHelpers.Col_BuildTimeUtc</th>
                        <th>@Ans.Net10.Web.Resources.SystemHelpers.Col_Location</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var asm1 in info1.Assemblies)
                    {
                        var rowClass1 = asm1.IsAns ? "fw-semibold" : null;
                        <tr class="@rowClass1">
                            <td class="ps-3">@asm1.Name</td>
                            <td>@asm1.Version</td>
                            <td>
                                @if (asm1.IsDebug is true)
                                {
                                    <span class="badge text-bg-warning">Debug</span>
                                }
                                else if (asm1.IsDebug is false)
                                {
                                    <span class="badge text-bg-success">Release</span>
                                }
                                else
                                {
                                    <span class="text-body-secondary">—</span>
                                }
                            </td>
                            <td class="text-body-secondary">@(asm1.BuildTimeUtc?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</td>
                            <td class="text-body-secondary text-truncate" style="max-width: 28rem;" title="@asm1.Location">@asm1.Location</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@functions {

    sealed class SystemDiagnosticInfo
    {
        public SystemDiagnosticInfo(
            IWebHostEnvironment env)
        {
            using var proc1 = Process.GetCurrentProcess();
            ProcessStartTime = proc1.StartTime;
            WorkingSetMb = Math.Round(proc1.WorkingSet64 / 1024d / 1024d, 1);

            Assemblies = AppDomain.CurrentDomain.GetAssemblies()
                .Where(a => !a.IsDynamic)
                .Select(a => new AssemblyItemInfo(a))
                .OrderByDescending(a => a.IsAns)
                .ThenBy(a => a.Name)
                .ToArray();

            EnvVars = Environment.GetEnvironmentVariables()
                .Cast<System.Collections.DictionaryEntry>()
                .Select(e => new KeyValuePair<string, string>(e.Key?.ToString() ?? string.Empty, e.Value?.ToString() ?? string.Empty))
                .Where(kv => kv.Key.StartsWith("ASPNETCORE_", StringComparison.OrdinalIgnoreCase)
                    || kv.Key.StartsWith("DOTNET_", StringComparison.OrdinalIgnoreCase))
                .OrderBy(kv => kv.Key)
                .ToArray();
        }

        public DateTime ProcessStartTime { get; }
        public double WorkingSetMb { get; }
        public IReadOnlyList<AssemblyItemInfo> Assemblies { get; }
        public IReadOnlyList<KeyValuePair<string, string>> EnvVars { get; }
    }


    sealed class AssemblyItemInfo
    {
        public AssemblyItemInfo(Assembly asm)
        {
            var asmName1 = asm.GetName();
            Name = asmName1.Name ?? string.Empty;
            Version = asmName1.Version?.ToString() ?? "—";
            IsAns = Name.StartsWith("Ans.", StringComparison.OrdinalIgnoreCase);

            var dbgAttr1 = asm.GetCustomAttribute<DebuggableAttribute>();
            IsDebug = dbgAttr1 is not null
                ? dbgAttr1.IsJITOptimizerDisabled
                : null;

            try
            {
                Location = asm.Location;
                if (!string.IsNullOrEmpty(Location) && File.Exists(Location))
                    BuildTimeUtc = File.GetLastWriteTimeUtc(Location);
            }
            catch
            {
                Location = string.Empty;
            }
        }

        public string Name { get; }
        public string Version { get; }
        public bool IsAns { get; }
        public bool? IsDebug { get; }
        public DateTime? BuildTimeUtc { get; }
        public string Location { get; } = string.Empty;
    }

}
