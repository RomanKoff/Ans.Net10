@*
    rev 2026-11-27
    
    Компонент библиотеки Ans.Net10.Web.
    Код не предназначен для редактирования и компиляции во время выполнения!
    
    =============================
    Агрегатор Dynamic Compilation
    =============================

*@
@model object?
@using Ans.Net10.Web.Compilation
@using Ans.Net10.Web.Services
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject LibWebOptions Options
@inject AnsSystemAccessService AccessService
@inject AnsAppCodeCompiler? AppCodeCompiler
@inject AnsRazorViewCompiler? ViewCompiler

@{
    Current.Meta.RobotsOff();

    var hasAccess1 = await AccessService.HasAccessAsync();
    if (!hasAccess1 && !AccessService.HasAccessList)
    {
        Current.ThrowNotFound();
        return;
    }
}

<partial name="/Areas/Ans/Helpers/System/_AccessGate.cshtml" model="hasAccess1" />

@if (!hasAccess1)
{
    return;
}

@{
    var apiBaseUrl1 = Current.GetAnsApiBaseUrl(
        Model ?? Options.SystemHelpers.CompileApiUrl, "/api/ans/compile");

    var isEnabled1 = AppCodeCompiler is not null && ViewCompiler is not null;
    var appCodePath1 = Options.DynamicCompilation?.AppCodePath ?? Ans.Net10.Web.Resources.SystemHelpers.Text_NotConfigured;
    var res1 = AppCodeCompiler?.LastResult;
    var xsrfToken1 = Antiforgery.GetAndStoreTokens(Context).RequestToken;

    var i18n1 = new
    {
        code = Ans.Net10.Web.Resources.SystemHelpers.Col_Code,
        file = Ans.Net10.Web.Resources.SystemHelpers.Col_File,
        lineCol = Ans.Net10.Web.Resources.SystemHelpers.Col_LineColumn,
        desc = Ans.Net10.Web.Resources.SystemHelpers.Col_Description,
        asmActive = string.Format(Ans.Net10.Web.Resources.SystemHelpers.Compile_AssemblyActiveFormat, appCodePath1),
        asmError = string.Format(Ans.Net10.Web.Resources.SystemHelpers.Compile_AssemblyErrorFormat, appCodePath1),
        builtIn = Ans.Net10.Web.Resources.SystemHelpers.Compile_BuiltInFormat,
        filesCs = Ans.Net10.Web.Resources.SystemHelpers.Compile_FilesCsFormat,
        exportedTypes = Ans.Net10.Web.Resources.SystemHelpers.Compile_ExportedTypesFormat,
        batchSuccess = Ans.Net10.Web.Resources.SystemHelpers.Compile_BatchSuccess,
        batchError = Ans.Net10.Web.Resources.SystemHelpers.Compile_BatchErrorFormat,
        buildTime = Ans.Net10.Web.Resources.SystemHelpers.Compile_BuildTimeFormat,
        total = Ans.Net10.Web.Resources.SystemHelpers.Compile_TotalFormat,
        succeeded = Ans.Net10.Web.Resources.SystemHelpers.Compile_SucceededFormat,
        failed = Ans.Net10.Web.Resources.SystemHelpers.Compile_FailedFormat
    };
}

<div id="ansCompileRoot"
     data-api-base="@apiBaseUrl1"
     data-xsrf="@xsrfToken1"
     data-i18n='@Json.Serialize(i18n1)'>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div class="text-body-secondary small">
            @Ans.Net10.Web.Resources.SystemHelpers.Compile_ModelsDirectoryLabel: <code>@appCodePath1</code>
        </div>
        @if (isEnabled1)
        {
            <div class="d-flex flex-wrap gap-2">
                <button type="button" id="ansCompileReloadBtn" class="btn btn-primary">
                    @Ans.Net10.Web.Resources.SystemHelpers.Compile_ReloadModelsBtn
                </button>
                <button type="button" id="ansCompileBatchBtn" class="btn btn-outline-primary">
                    @Ans.Net10.Web.Resources.SystemHelpers.Compile_BatchCheckBtn
                </button>
            </div>
        }
    </div>

    @if (!isEnabled1)
    {
        <div class="alert alert-warning mb-0">
            @Html.Raw(Ans.Net10.Web.Resources.SystemHelpers.Compile_SubsystemDisabledHtml)
        </div>
    }
    else
    {
        <div id="ansCompileAppCodeBox">
            @if (res1 is not null)
            {
                <div class="card mb-4 @(res1.Success ? "border-success" : "border-danger")">
                    <div class="card-header d-flex justify-content-between align-items-center @(res1.Success ? "bg-success-subtle text-success-emphasis" : "bg-danger-subtle text-danger-emphasis")">
                        <strong>
                            @(res1.Success
                                ? string.Format(Ans.Net10.Web.Resources.SystemHelpers.Compile_AssemblyActiveFormat, appCodePath1)
                                : string.Format(Ans.Net10.Web.Resources.SystemHelpers.Compile_AssemblyErrorFormat, appCodePath1))
                        </strong>
                        <span class="small">
                            @string.Format(Ans.Net10.Web.Resources.SystemHelpers.Compile_BuiltInFormat, res1.ElapsedMilliseconds, res1.CompiledAtUtc.ToString("yyyy-MM-dd HH:mm:ss"))
                        </span>
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge text-bg-secondary">@string.Format(Ans.Net10.Web.Resources.SystemHelpers.Compile_FilesCsFormat, res1.SourceFilesCount)</span>
                            <span class="badge text-bg-info">@string.Format(Ans.Net10.Web.Resources.SystemHelpers.Compile_ExportedTypesFormat, res1.ExportedTypesCount)</span>
                        </div>
                        @if (res1.Errors.Count > 0)
                        {
                            <div class="table-responsive mt-3">
                                <table class="table table-sm table-bordered mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>@Ans.Net10.Web.Resources.SystemHelpers.Col_Code</th>
                                            <th>@Ans.Net10.Web.Resources.SystemHelpers.Col_File</th>
                                            <th>@Ans.Net10.Web.Resources.SystemHelpers.Col_LineColumn</th>
                                            <th>@Ans.Net10.Web.Resources.SystemHelpers.Col_Description</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var err1 in res1.Errors)
                                        {
                                            <tr>
                                                <td class="font-monospace text-danger">@err1.ErrorCode</td>
                                                <td class="font-monospace small">@err1.FilePath</td>
                                                <td class="font-monospace text-nowrap">@err1.Line:@err1.Column</td>
                                                <td>@err1.Message</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div id="ansCompileBatchBox"></div>
    }
</div>

<script src="~/_content/Ans.Net10.Web/Areas/Ans/Helpers/System/Compilation.cshtml.js" defer></script>
