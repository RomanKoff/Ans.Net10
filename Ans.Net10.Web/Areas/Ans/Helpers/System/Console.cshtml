@*
    rev 2026-11-27
    
    Компонент библиотеки Ans.Net10.Web.
    Код не предназначен для редактирования и компиляции во время выполнения!
    
    =================
    Output приложения
    =================

*@
@model object?
@using Ans.Net10.Web.Services
@using Serilog.Events
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject LibWebOptions Options
@inject AnsSystemAccessService AccessService
@inject AnsMemoryLogStore? LogStore

@{
    Current.Meta.RobotsOff();

    var hasAccess1 = await AccessService.HasAccessAsync();
    if (!hasAccess1 && !AccessService.HasAccessList)
    {
        Current.ThrowNotFound();
        return;
    }
}

<partial name="/Areas/Ans/Helpers/System/_AccessGate.cshtml" model="hasAccess1" />

@if (!hasAccess1)
{
    return;
}

@{
    var apiBaseUrl1 = Current.GetAnsApiBaseUrl(
        Model ?? Options.SystemHelpers.ConsoleApiUrl, "/api/ans/console");

    var entries1 = LogStore?.GetEntries() ?? Array.Empty<AnsLogEntry>();
    var lastId1 = entries1.Length > 0 ? entries1[^1].Id : 0;
    var xsrfToken1 = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}

<div class="card shadow-sm">
    <div class="card-header d-flex flex-wrap align-items-center gap-3 py-2">
        <span class="fw-semibold me-auto">
            @Ans.Net10.Web.Resources.SystemHelpers.Console_Title
            <span class="badge text-bg-secondary ms-1">@string.Format(Ans.Net10.Web.Resources.SystemHelpers.Console_BufferFormat, LogStore?.Capacity ?? 0)</span>
        </span>

        <select id="ansConsoleLevelFilter" class="form-select form-select-sm w-auto" aria-label="@Ans.Net10.Web.Resources.SystemHelpers.Console_LevelFilterAriaLabel">
            <option value="">@Ans.Net10.Web.Resources.SystemHelpers.Console_AllLevels</option>
            <option value="1">DBG+</option>
            <option value="2">INF+</option>
            <option value="3" selected>WRN+</option>
            <option value="4">ERR+</option>
            <option value="5">FTL</option>
        </select>

        <div class="form-check form-switch m-0">
            <input class="form-check-input" type="checkbox" id="ansConsoleLiveCheck" checked />
            <label class="form-check-label small" for="ansConsoleLiveCheck">@Ans.Net10.Web.Resources.SystemHelpers.Console_LiveLabel</label>
        </div>

        <button type="button" id="ansConsoleClearBtn" class="btn btn-sm btn-outline-danger">@Ans.Net10.Web.Resources.SystemHelpers.Console_ClearBtn</button>
    </div>

    <div id="ansConsoleTerminal"
         class="card-body bg-body-tertiary font-monospace small overflow-y-auto p-3"
         style="height: 65vh; font-size: 0.75rem; line-height: 1.2;"
         data-api-base="@apiBaseUrl1"
         data-last-id="@lastId1"
         data-xsrf="@xsrfToken1">
        @if (LogStore is null)
        {
            <div class="text-warning-emphasis">@Ans.Net10.Web.Resources.SystemHelpers.Console_MemoryBufferDisabled</div>
        }
        else
        {
            foreach (var item1 in entries1.Reverse())
            {
                var lvlClass1 = item1.Level switch
                {
                    LogEventLevel.Information => "text-success-emphasis",
                    LogEventLevel.Warning => "text-warning-emphasis",
                    LogEventLevel.Error => "text-danger-emphasis",
                    LogEventLevel.Fatal => "badge text-bg-danger",
                    _ => "text-body-secondary"
                };
                <div class="border-bottom border-secondary-subtle py-1 text-break" data-lvl="@((int)item1.Level)">
                    <span class="text-body-secondary">@item1.Timestamp.ToString("HH:mm:ss.fff")</span>
                    <span class="fw-bold @lvlClass1">[@item1.LevelShortName]</span>
                    @if (!string.IsNullOrEmpty(item1.SourceContext))
                    {
                        <span class="text-info-emphasis">[@item1.SourceContext]</span>
                    }
                    <span style="white-space: pre-wrap;">@item1.Message</span>
                    @if (!string.IsNullOrEmpty(item1.Exception))
                    {
                        <div class="text-danger-emphasis border-start border-2 border-danger ps-3 mt-1" style="white-space: pre-wrap;">@item1.Exception</div>
                    }
                </div>
            }
        }
    </div>
</div>

<script src="~/_content/Ans.Net10.Web/Areas/Ans/Helpers/System/Console.cshtml.js" defer></script>
