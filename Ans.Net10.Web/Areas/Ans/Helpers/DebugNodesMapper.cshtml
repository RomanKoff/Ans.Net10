@using Ans.Net10.Web.Nodes
@inject NodesMapper Nodes
@*
	rev. 2026-011-10
	
	Компонент библиотеки Ans.Net10.Web.
	Код не предназначен для редактирования и компиляции во время выполнения!
*@
@{
	OutNodes(Nodes);
}

@functions {

	void OutNodes(NodesMapper nodes)
	{
		if (nodes is null)
			return;
		<ul>
			@foreach (var item1 in nodes.Map.OrderBy(x=>x.Key))
			{
				<li><code>@(item1.Key)</code> = "@(item1.Value)"</li>
			}
		</ul>
	}

}