@*
Компонент библиотеки Ans.Net10.Web.
Код не предназначен для редактирования и компиляции во время выполнения!
*@

@{
	OutNodes(Current.Sitemap.TopNodes);
}

@functions {

	void OutNodes(IReadOnlyCollection<NodemapItem> items)
	{
		if (!items.Any())
			return;
		<ul>
			@foreach (var item1 in items)
			{
				var url1 = item1.GetUrl(Context);
				<li>
					<span>
						@GetTagsInfo(item1).ToHtml()<b>@item1.Type</b>
						@switch (item1.Type)
						{
							case NodemapTypesEnum.Group:
								<tt>@(item1.Name)</tt>
								break;
							case NodemapTypesEnum.Node:
								<a class="font-monospace" href="@url1">@item1.Name</a>
								break;
							case NodemapTypesEnum.InternalPath:
								<a class="font-monospace" href="@url1">@item1.Target</a>
								break;
							default:
								<a class="font-monospace" target="_blank" href="@url1">@item1.Target</a>
								break;
						}
						@item1.IsShortTitleUnique.ToHtml($"({item1.ShortTitleHtml})&nbsp;")@item1.TitleHtml
					</span>
					@{
						OutPages(item1.TopPages);
						OutNodes(item1.ChildNodes);
					}
				</li>
			}
		</ul>
	}

	void OutPages(IReadOnlyCollection<PagemapItem> items)
	{
		if (!items.Any())
			return;
		<ul style="font-size:.8rem;">
			@foreach (var item1 in items)
			{
				var url1 = item1.GetUrl(Context);
				<li>
					<span>
						@GetTagsInfo(item1).ToHtml()<i>@item1.Type</i>
						@switch (item1.Type)
						{
							case PagemapTypesEnum.Catalog:
								@if (item1.HasNoIndex)
								{
									<tt>@(item1.Name)/</tt>
								}
								else
								{
									<a class="font-monospace" href="@url1">@item1.Name</a>
								}
								break;
							case PagemapTypesEnum.Page:
								<a class="font-monospace" href="@url1">@item1.Name</a>
								break;
							case PagemapTypesEnum.InternalPath:
								<a class="font-monospace" href="@url1">@item1.Target</a>
								break;
							default:
								<a class="font-monospace" target="_blank" href="@url1">@item1.Target</a>
								break;
						}
						@item1.IsShortTitleUnique.ToHtml($"({item1.ShortTitleHtml})&nbsp;")@item1.TitleHtml
					</span>
					@{
						OutPages(item1.ChildPages);
					}
				</li>
			}
		</ul>
	}

	string GetTagsInfo(_MapItem_Proto item)
	{
		var s1 = (!item.IsDisplayed()).Make(
			"<em class=\"text-danger\" title=\"Hidden\">[H]&nbsp;</em>");
		var s2 = item.IsPassthrough().Make(
			"<em class=\"text-danger\" title=\"Passthrough\">[P]&nbsp;</em>");
		return $"{s1}{s2}";
	}

}