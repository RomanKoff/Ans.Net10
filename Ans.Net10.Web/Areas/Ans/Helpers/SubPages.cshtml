@*
	Компонент библиотеки Ans.Net10.Web.
	Код не предназначен для редактирования и компиляции во время выполнения!
*@
@if (Current.Page.MapItem?.HasChildPages ?? false)
{
	OutItems(Current.Page.MapItem.ChildPages);
}

@functions {

	void OutItems(IEnumerable<PagemapItem> items)
	{
		<ul>
			@foreach (var item1 in items)
			{
				var tag1 = item1.GetLink(Context).GetTag();
				<li class="nav-item">@tag1</li>
			}
		</ul>
	}

}
