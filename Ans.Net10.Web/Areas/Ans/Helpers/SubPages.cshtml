@{
	var pages1 = Current.GetSubpagesNav(1);
}

@if (pages1 is { Count: > 0 })
{
	<ul>
		@foreach (var item1 in pages1)
		{
			<li class="nav-item">@item1.ToLinkBuilder().GetTag()</li>
		}
	</ul>
}
