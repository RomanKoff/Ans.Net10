<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="Ans_Net10_Web_MapPages"
		   targetNamespace="urn:ans:net10:web:map-pages"
		   attributeFormDefault="unqualified"
		   elementFormDefault="qualified"
		   xmlns="urn:ans:net10:web:map-pages"
		   xmlns:xs="http://www.w3.org/2001/XMLSchema">

	<xs:element name="pages">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="item" type="ItemType" minOccurs="0" maxOccurs="unbounded" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:complexType name="ItemType">
		<xs:sequence>
			<xs:element name="item" type="ItemType" minOccurs="0" maxOccurs="unbounded" />
		</xs:sequence>
		<xs:attribute name="target" type="xs:string" use="required">
			<xs:annotation>
				<xs:documentation>
					1. Если начинается с '/', то InternalPath.
					2. Иначе, если соответствует "^([0-9a-z_-]+)$", то Page или Catalog, если имеет дочерние страницы.
					3. Иначе ExternalUrl.
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="face" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation>
					1. "Полное название";
					2. "Короткое название|Шаблон полного названия ({0} для подстановки короткого названия)"
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="no-index" type="xs:boolean" use="optional" default="false">
			<xs:annotation>
				<xs:documentation>Не имеет стартовой страницы.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="display" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation>
					Получает или задает декларативное правило отображения элемента.
					Формат строки: "теги_показа|теги_скрытия" (например, "main,header", "|footer").
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="pass" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation>
					Получает или задает декларативное правило сквозного поведения элемента.
					Формат строки: "теги_включения|теги_исключения" (например, "footer", "|main,header").
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

</xs:schema>
