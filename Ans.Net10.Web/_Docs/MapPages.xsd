<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="Ans_Net10_Web_MapPages"
		   targetNamespace="urn:ans:net10:web:map-pages"
		   attributeFormDefault="unqualified"
		   elementFormDefault="qualified"
		   xmlns="urn:ans:net10:web:map-pages"
		   xmlns:xs="http://www.w3.org/2001/XMLSchema">

	<xs:element name="pages">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="item" type="ItemType" minOccurs="0" maxOccurs="unbounded" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:complexType name="ItemType">
		<xs:sequence>
			<xs:element name="item" type="ItemType" minOccurs="0" maxOccurs="unbounded" />
		</xs:sequence>
		<xs:attribute name="target" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation>
					1. null -> Catalog;
					2. "/*" -> InternalPath;
					3. "^([0-9a-z_-]+)$" -> Page;
					4. ExternalUrl.
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="face" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation>
					1. "full_title";
					2. "short_title|full_title_template"
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="hide" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation>Список тегов для которых элемент не отображается.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="show" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation>Список тегов только для которых элемент отображается.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="pass" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation>Список тегов в которых элемент невидим, но вместо себя выводит свои дочерние элементы.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

</xs:schema>
