<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="Ans_Net10_Web_MapNodes"
		   targetNamespace="urn:ans:net10:web:map-nodes"
		   attributeFormDefault="unqualified"
		   elementFormDefault="qualified"
		   xmlns="urn:ans:net10:web:map-nodes"
		   xmlns:xs="http://www.w3.org/2001/XMLSchema">

	<xs:element name="nodes">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="item" type="ItemType" minOccurs="0" maxOccurs="unbounded" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:complexType name="ItemType">
		<xs:sequence>
			<xs:element name="item" type="ItemType" minOccurs="0" maxOccurs="unbounded" />
		</xs:sequence>
		<xs:attribute name="target" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation>
					1. Если пустой, то Group.
					2. Если начинается с '/', то InternalPath.
					3. Иначе, если соответствует "^([0-9a-z_-]+)$", то Node.
					4. Иначе ExternalUrl.
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="face" type="xs:string" use="required">
			<xs:annotation>
				<xs:documentation>
					1. "Полное название";
					2. "Короткое название|Шаблон полного названия ({0} для подстановки короткого названия)"
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="hide" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation>Список тегов для которых элемент не отображается.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="show" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation>Список тегов только для которых элемент отображается.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="pass" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation>Список тегов в которых элемент невидим, но вместо себя выводит свои дочерние элементы.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

</xs:schema>
