<Project>

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>

	<ItemGroup>
		<PackageVersion Include="CsvHelper" Version="34.0.0" />
		<PackageVersion Include="Magick.NET-Q16-AnyCPU" Version="15.1.0" />
		<PackageVersion Include="MailKit" Version="5.0.0" />
		<PackageVersion Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="[10.0.15,11)" />
		<PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="[10.0.15,11)" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore" Version="[10.0.15,11)" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="[10.0.15,11)" />
		<PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="[10.11.0,11)" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[10.0.15,11)" />
		<PackageVersion Include="PuppeteerSharp" Version="25.15.0" />
		<PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
		<PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageVersion Include="Serilog.Sinks.Map" Version="2.0.0" />
		<PackageVersion Include="System.Security.Cryptography.Pkcs" Version="[10.0.15,11)" />
		<PackageVersion Include="System.ServiceModel.Syndication" Version="[10.0.15,11)" />
	</ItemGroup>

</Project>