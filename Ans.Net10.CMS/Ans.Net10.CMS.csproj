<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>

		<SatelliteResourceLanguages>ru-RU,en-US</SatelliteResourceLanguages>
		<CopyRefAssembliesToPublishDirectory>true</CopyRefAssembliesToPublishDirectory>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Views\Nodes\dev\**" />
	  <Content Remove="Views\Nodes\dev\**" />
	  <EmbeddedResource Remove="Views\Nodes\dev\**" />
	  <None Remove="Views\Nodes\dev\**" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Ans.Net10.Common\Ans.Net10.Common.csproj" />
		<ProjectReference Include="..\Ans.Net10.Web\Ans.Net10.Web.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="_app_offline.htm">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<None Update="__update_*.cmd">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<Content Remove="appsettings.Development.json" />
		<None Include="appsettings.Development.json" />
	</ItemGroup>

</Project>
