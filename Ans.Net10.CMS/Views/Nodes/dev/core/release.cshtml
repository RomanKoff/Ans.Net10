@functions {

    void OutInfo(string site, string[] nodes)
    {
        var nodes1 = nodes.Select(x => new NodeInfo(x));
        var works1 = nodes1.Where(x => !x.HasInfo);
        var compls1 = nodes1.Where(x => x.HasInfo).OrderByDescending(x => x.Date);
        <div class="my-5">
            <h4 class="m-0">@site</h4>
            <ol class="theme-columns-3">
                @foreach (var info1 in works1)
                {
                    var css1 = info1.HasInfo.Make("text-decoration-line-through opacity-50");
                    var addon1 = info1.HasInfo.Make($" ({info1.Info}, {info1.Date})");
                    <li class="@css1"><a target="_blank" href="https://@site/@info1.Name">@info1.Name @(info1.IsHard.Make("<i class=\"bi-exclamation-circle text-danger\"></i>").ToHtml())</a>@addon1.ToHtml()</li>
                }
            </ol>
            @if (compls1?.Count() > 0)
            {
                <p class="m-0">Лог:</p>
                <ul>
                    @foreach (var info1 in compls1)
                    {
                        <li>@info1.Date — @info1.Name (@info1.Info)</li>
                    }
                </ul>
            }
        </div>
    }

    class NodeInfo
    {
        public NodeInfo(string data)
        {
            var a1 = data.Split(':');
            if (a1.Length == 3)
            {
                Info = a1[1];
                Date = a1[2].ToDateOnly();
            }
            _parseName(a1[0]);
        }

        public string Name { get; set; }
        public bool IsHard { get; set; }
        public string Info { get; set; }
        public DateOnly? Date { get; set; }

        public bool HasInfo => Info != null;

        private void _parseName(string name)
        {
            if (name[0] == '!')
            {
                IsHard = true;
                Name = name[1..];
            }
            else
            {
                Name = name;
            }
        }
    }

}